# ==============================================================================
# ACADSHIELD CORE - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env in each corresponding directory or at root for Docker
# ==============================================================================

# ------------------------------------------------------------------------------
# APPLICATION & SERVER
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# DATABASE (PostgreSQL)
# ------------------------------------------------------------------------------
POSTGRES_USER=acadshield
POSTGRES_PASSWORD=replace_with_a_local_only_password
POSTGRES_DB=acadshield_core
POSTGRES_PORT=5432
DATABASE_URL="postgresql://acadshield:replace_with_a_local_only_password@localhost:5432/acadshield_core?schema=public"

# ------------------------------------------------------------------------------
# AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Use an independently generated 32-byte or longer random secret.
JWT_SECRET=

# ------------------------------------------------------------------------------
# PROJECT B (ACADSHIELD TRUST) INTEGRATION SERVICE KEY
# ------------------------------------------------------------------------------
# Shared random service secret. Configure the same value as
# PROJECT_A_INTERNAL_API_KEY in acadshield-trust.
INTERNAL_SERVICE_API_KEY=

# ------------------------------------------------------------------------------
# DOCUMENT ANALYSIS SERVICE
# ------------------------------------------------------------------------------
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=
DOCUMENT_STORAGE_DIR=storage/documents
MAX_DOCUMENT_BYTES=15728640
SOURCE_PROVIDER=unconfigured
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_REDIRECT_URI=
DIGILOCKER_ENV=production
NAD_CLIENT_ID=
NAD_CLIENT_SECRET=

# Single-issuer VC-JWT deployment. Do not share one issuer key across institutions.
VC_ISSUER_INSTITUTION_ID=
VC_ISSUER_DID=
VC_ISSUER_KEY_ID=
VC_ISSUER_PRIVATE_KEY_PEM=
VC_ISSUER_PUBLIC_KEY_PEM=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# ------------------------------------------------------------------------------
# BLOCKCHAIN & WEB3
# ------------------------------------------------------------------------------
# Network: Polygon Amoy Testnet (Chain ID 80002) or Local Hardhat (Chain ID 31337)
BLOCKCHAIN_RPC_URL=https://rpc-amoy.polygon.technology
CHAIN_ID=80002
# Test deployer wallet private key (NEVER commit real mainnet keys)
DEPLOYER_PRIVATE_KEY=
# Separate issuer key for the backend mint/revoke API; authorize its address on the deployed contract.
BLOCKCHAIN_ISSUER_PRIVATE_KEY=
BLOCKCHAIN_RECIPIENT_ADDRESS=

# Deployed Contract Addresses (Populated after deploying contracts/)
ACCESS_CONTROL_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
IDENTITY_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
CREDENTIAL_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Polygonscan API Key for Contract Verification
POLYGONSCAN_API_KEY=your_polygonscan_api_key_here

# ------------------------------------------------------------------------------
# IPFS / PINATA STORAGE
# ------------------------------------------------------------------------------
# Public Pinata storage is optional and only receives a PII-free credential manifest.
# Set to "pinata" and provide a scoped JWT to enable public metadata upload.
IPFS_STORAGE_MODE=disabled
IPFS_JWT=

# ------------------------------------------------------------------------------
# PUBLIC VERIFICATION & QR
# ------------------------------------------------------------------------------
VERIFY_BASE_URL=http://localhost:3000/verify

# ------------------------------------------------------------------------------
# FRONTEND PUBLIC CONFIG (Next.js)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_CHAIN_ID=80002
NEXT_PUBLIC_CHAIN_NAME="Polygon Amoy Testnet"
NEXT_PUBLIC_VERIFY_BASE_URL=http://localhost:3000/verify
NEXT_PUBLIC_CREDENTIAL_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Upload protection. Required for production uploads; never put this key in NEXT_PUBLIC_*.
# Generate and securely back up a random 32-byte key encoded as 64 hex characters.
DOCUMENT_ENCRYPTION_KEY=
# Run clamd on a private network; its TCP protocol does not authenticate clients.
CLAMAV_HOST=
CLAMAV_PORT=3310
# Explicit local-development opt-in only; ignored in production.
ALLOW_UNSCANNED_UPLOADS=false
