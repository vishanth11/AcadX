# ==============================================================================
# ACADSHIELD TRUST (PROJECT B) - MASTER ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# APPLICATION & GATEWAY
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:3001
FRONTEND_URL=http://localhost:3001

# ------------------------------------------------------------------------------
# DATABASE (PostgreSQL)
# ------------------------------------------------------------------------------
POSTGRES_USER=acadshield_trust
POSTGRES_PASSWORD=replace_with_a_local_only_password
POSTGRES_DB=acadshield_trust
POSTGRES_PORT=5433
DATABASE_URL="postgresql://acadshield_trust:replace_with_a_local_only_password@localhost:5433/acadshield_trust?schema=public"

# ------------------------------------------------------------------------------
# AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
JWT_SECRET=
JWT_ACCESS_EXPIRY=1h

# ------------------------------------------------------------------------------
# PROJECT A (ACADSHIELD CORE) INTEGRATION
# ------------------------------------------------------------------------------
# This implementation uses Project A when configured; otherwise it reports SOURCE_UNAVAILABLE.
CREDENTIAL_PROVIDER=project_a
PROJECT_A_API_URL=http://localhost:4000/api/v1
# Service key used when invoking Project A's internal verification API
PROJECT_A_INTERNAL_API_KEY=
PROJECT_A_TIMEOUT_MS=4000

# Optional hashed company API key provisioning (requires a company UUID in Core)
TRUST_API_KEY=
TRUST_API_COMPANY_ID=

# ------------------------------------------------------------------------------
# AI RISK ANALYSIS SERVICE (Python FastAPI)
# ------------------------------------------------------------------------------
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=
AI_SERVICE_TIMEOUT_MS=3000
# Optional trusted Isolation Forest artifact generated by the AI service trainer.
# Leave blank until institution-approved training data and validation are complete.
ANOMALY_MODEL_PATH=

# ------------------------------------------------------------------------------
# BILLING & WEBHOOK ABSTRACTIONS
# ------------------------------------------------------------------------------
BILLING_PROVIDER=mock
WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Next.js)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_TRUST_URL=http://localhost:3001
